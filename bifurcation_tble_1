
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "R=np.linspace(2.5,4,10000) #to control the parameter range\n",
    "\n",
    "X = [] #x axis, controls the R values\n",
    "Y = [] #y axis, is the x values of the logistic map\n",
    "\n",
    "#generate x for each value of r\n",
    "for r in R:\n",
    "    X.append(r)\n",
    "    \n",
    "    x = np.random.random() #initialize x for each r value\n",
    "    for n in range(100):\n",
    "        x=r*x*(1-x) #formula - iterate to let system stabilize\n",
    "    \n",
    "    for n in range(100):\n",
    "        x=r*x*(1-x) #formula - continue iterating\n",
    "    \n",
    "    Y.append(x) #moved inside the loop to record one y-value for each r-value\n",
    "\n",
    "plt.plot(X, Y, ls='', marker=',')\n",
    "plt.show()"
